@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(onnxruntime_DIR "@onnxruntime_DIR@")
find_package(onnxruntime REQUIRED)

find_package(CUDAToolkit REQUIRED)

find_package(TBB REQUIRED)

find_package(OpenMP REQUIRED)

find_package(faiss REQUIRED)

# TensorRT remains optional for non-TensorRT builds. When xfeat-cpp was built
# with TensorRT, its exported targets (including the FFS GWC plugin) require the
# matching runtime and headers.
set(TENSORRT_AVAILABLE @TENSORRT_AVAILABLE@)
if(TENSORRT_AVAILABLE)
    find_library(TENSORRT_LIBRARY nvinfer
        PATHS /usr/local/lib /usr/lib
              /usr/lib/aarch64-linux-gnu
              /usr/lib/x86_64-linux-gnu
              /usr/local/TensorRT/lib /usr/local/tensorrt/lib
              /opt/TensorRT/lib /opt/tensorrt/lib
    )
    find_path(TENSORRT_INCLUDE_DIR NvInfer.h
        PATHS /usr/include /usr/local/include
              /usr/include/aarch64-linux-gnu
              /usr/include/x86_64-linux-gnu
              /usr/local/TensorRT/include /usr/local/tensorrt/include
              /opt/TensorRT/include /opt/tensorrt/include
    )

    if(NOT TENSORRT_LIBRARY OR NOT TENSORRT_INCLUDE_DIR)
        message(FATAL_ERROR "xfeat-cpp was built with TensorRT, but TensorRT could not be found")
    endif()
    if(TENSORRT_LIBRARY AND NOT TARGET TensorRT::nvinfer)
        add_library(TensorRT::nvinfer UNKNOWN IMPORTED)
        set_target_properties(TensorRT::nvinfer PROPERTIES
            IMPORTED_LOCATION "${TENSORRT_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${TENSORRT_INCLUDE_DIR}"
        )
        message(STATUS "Found TensorRT for xfeat-cpp: ${TENSORRT_LIBRARY}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xfeat-cppTargets.cmake")

set(xfeat-cpp_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include" ${onnxruntime_INCLUDE_DIR})
set(xfeat-cpp_LIBRARIES xfeat-cpp::xfeat-cpp xfeat-cpp::sgm)
if(TENSORRT_AVAILABLE)
    list(APPEND xfeat-cpp_LIBRARIES xfeat-cpp::xfeat_ffs_gwc_plugin)
endif()
